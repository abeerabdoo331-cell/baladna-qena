rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOptionalId(id) {
      return id is string && (id == '' || (id.size() >= 2 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$')));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'abeerabdoo331@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isUserNotBlocked() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBlocked == false;
    }

    function isDefaultCategoryId(catId) {
      return catId in [
        'qena-market',
        'qena-health',
        'qena-services',
        'qena-jobs',
        'qena-transport',
        'qena-aid',
        'qena-health-doctors',
        'qena-health-pharmacies',
        'qena-health-labs',
        'qena-services-crafts',
        'qena-services-delivery',
        'qena-services-teachers',
        'qena-services-home',
        'doctors-pharmacies',
        'teachers',
        'craftsmen',
        'hegaza-market',
        'shops',
        'drivers-transport',
        'home-projects',
        'jobs',
        'ads',
        'delivery',
        'delivery-purchases'
      ];
    }

    function isDefaultCenterId(centerId) {
      return centerId in [
        'qena',
        'qus',
        'nag-hammadi',
        'deshna',
        'abu-tesht',
        'farshout',
        'naqada',
        'al-waqf',
        'qift'
      ];
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'parentId', 'name', 'description', 'iconKey', 'accentColor', 'order', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'parentId', 'name', 'description', 'iconKey', 'accentColor', 'order', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id.size() >= 2 && data.id.size() <= 64
        && isValidOptionalId(data.parentId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.description is string && data.description.size() <= 160
        && data.iconKey in ['medical', 'education', 'crafts', 'market', 'shop', 'transport', 'home', 'jobs', 'ads', 'delivery', 'aid', 'services', 'health', 'general']
        && data.accentColor is string && data.accentColor.size() == 7 && data.accentColor.matches('^#[0-9a-fA-F]{6}$')
        && data.order is int && data.order >= 0 && data.order <= 100
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCenter(data) {
      return data.keys().hasAll(['id', 'name', 'order', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'order', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id.size() >= 2 && data.id.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.order is int && data.order >= 0 && data.order <= 100
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVillage(data) {
      return data.keys().hasAll(['id', 'centerId', 'name', 'order', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'centerId', 'name', 'order', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.id.size() >= 2 && data.id.size() <= 64
        && isValidId(data.centerId)
        && data.centerId.size() >= 2 && data.centerId.size() <= 64
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 60
        && data.order is int && data.order >= 0 && data.order <= 500
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidImageList(images) {
      return images is list
        && images.size() <= 3
        && (images.size() < 1 || (images[0] is string && images[0].size() > 0 && images[0].size() <= 140000))
        && (images.size() < 2 || (images[1] is string && images[1].size() > 0 && images[1].size() <= 140000))
        && (images.size() < 3 || (images[2] is string && images[2].size() > 0 && images[2].size() <= 140000));
    }

    function isValidPhoneOrPrivate(phone, hideContactInfo) {
      return phone is string
        && (
          (hideContactInfo == true && phone == '')
          || (phone.size() >= 6 && phone.size() <= 20 && phone.matches('^[0-9+\\-\\s()]{6,20}$'))
        );
    }

    function isValidListing(data) {
      return data.keys().hasAll([
          'title', 'serviceType', 'listingKind', 'contactPhone', 'hideContactInfo',
          'centerId', 'centerName', 'villageId', 'villageName', 'area', 'notes',
          'price', 'images', 'categoryId', 'subcategoryId', 'submittedByName',
          'authorUid', 'status', 'isFeatured', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'serviceType', 'listingKind', 'contactPhone', 'hideContactInfo',
          'centerId', 'centerName', 'villageId', 'villageName', 'area', 'notes',
          'price', 'images', 'categoryId', 'subcategoryId', 'submittedByName',
          'authorUid', 'status', 'isFeatured', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 80
        && data.serviceType is string && data.serviceType.size() >= 2 && data.serviceType.size() <= 80
        && data.listingKind in ['ad', 'service', 'job', 'aid']
        && data.hideContactInfo is bool
        && isValidPhoneOrPrivate(data.contactPhone, data.hideContactInfo)
        && isValidOptionalId(data.centerId)
        && data.centerName is string && data.centerName.size() <= 60
        && isValidOptionalId(data.villageId)
        && data.villageName is string && data.villageName.size() <= 60
        && data.area is string && data.area.size() <= 80
        && data.notes is string && data.notes.size() <= 600
        && data.price is string && data.price.size() <= 60
        && isValidImageList(data.images)
        && isValidId(data.categoryId) && data.categoryId.size() >= 2 && data.categoryId.size() <= 64
        && isValidOptionalId(data.subcategoryId)
        && data.submittedByName is string && data.submittedByName.size() >= 2 && data.submittedByName.size() <= 60
        && isValidId(data.authorUid)
        && data.status in ['pending', 'approved', 'rejected']
        && data.isFeatured is bool
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAidContact(data) {
      return data.keys().hasAll(['listingId', 'authorUid', 'contactPhone', 'requesterName', 'createdAt'])
        && data.keys().hasOnly(['listingId', 'authorUid', 'contactPhone', 'requesterName', 'createdAt'])
        && isValidId(data.listingId)
        && isValidId(data.authorUid)
        && data.contactPhone is string && data.contactPhone.size() >= 6 && data.contactPhone.size() <= 20 && data.contactPhone.matches('^[0-9+\\-\\s()]{6,20}$')
        && data.requesterName is string && data.requesterName.size() >= 2 && data.requesterName.size() <= 60
        && data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'body', 'priority', 'centerName', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'body', 'priority', 'centerName', 'isActive', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 600
        && data.priority in ['normal', 'important']
        && data.centerName is string && data.centerName.size() <= 60
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavoritesList(favs) {
      return favs is list
        && favs.size() <= 50
        && (favs.size() < 1 || isValidId(favs[0]));
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'phone', 'email', 'centerId', 'villageId', 'favorites', 'isBlocked', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'phone', 'email', 'centerId', 'villageId', 'favorites', 'isBlocked', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60
        && data.phone is string && (data.phone == '' || (data.phone.size() >= 6 && data.phone.size() <= 20 && data.phone.matches('^[0-9+\\-\\s()]{6,20}$')))
        && data.email is string && data.email.size() <= 120
        && isValidOptionalId(data.centerId)
        && isValidOptionalId(data.villageId)
        && isValidFavoritesList(data.favorites)
        && data.isBlocked is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAppUpdate(data) {
      return data.keys().hasAll(['versionName', 'versionCode', 'releaseNotes', 'apkUrl', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['versionName', 'versionCode', 'releaseNotes', 'apkUrl', 'isActive', 'createdAt', 'updatedAt'])
        && data.versionName is string && data.versionName.size() >= 1 && data.versionName.size() <= 30
        && data.versionCode is int && data.versionCode >= 1 && data.versionCode <= 100000
        && data.releaseNotes is string && data.releaseNotes.size() >= 2 && data.releaseNotes.size() <= 1000
        && data.apkUrl is string && data.apkUrl.size() <= 500 && (data.apkUrl == '' || data.apkUrl.matches('^https?://.*$'))
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['email', 'displayName', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 120
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.createdAt is timestamp;
    }

    // Connection health check endpoint
    match /test/connection {
      allow get: if true;
    }

    // Administrator registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdmin(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if isAdmin() && isValidId(adminId) && request.auth.uid != adminId;
    }

    // Main categories & internal subcategories (Admin-only writes)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == categoryId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().parentId == '' || isDefaultCategoryId(incoming().parentId) || exists(/databases/$(database)/documents/categories/$(incoming().parentId)));
      allow update: if isAdmin()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['parentId', 'name', 'description', 'iconKey', 'accentColor', 'order', 'isActive', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // Qena Centers (Admin-only writes)
    match /centers/{centerId} {
      allow get: if isValidId(centerId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(centerId)
        && isValidCenter(incoming())
        && incoming().id == centerId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(centerId)
        && isValidCenter(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'order', 'isActive', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(centerId);
    }

    // Qena Villages & Cities linked to Centers (Admin-only writes)
    match /villages/{villageId} {
      allow get: if isValidId(villageId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(villageId)
        && isValidVillage(incoming())
        && incoming().id == villageId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isDefaultCenterId(incoming().centerId) || exists(/databases/$(database)/documents/centers/$(incoming().centerId)));
      allow update: if isAdmin()
        && isValidId(villageId)
        && isValidVillage(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['centerId', 'name', 'order', 'isActive', 'updatedAt'])
        && (isDefaultCenterId(incoming().centerId) || exists(/databases/$(database)/documents/centers/$(incoming().centerId)));
      allow delete: if isAdmin() && isValidId(villageId);
    }

    // Qena listings: services, market ads, jobs, transport & charitable aid
    match /listings/{listingId} {
      allow get: if isValidId(listingId)
        && ((existing().status == 'approved' && (!('isActive' in existing()) || existing().isActive == true))
          || isAdmin()
          || (isSignedIn() && existing().authorUid == request.auth.uid));
      allow list: if (resource.data.status == 'approved' && (!('isActive' in resource.data) || resource.data.isActive == true))
        || isBootstrappedAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(listingId)
        && isValidListing(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || (incoming().status == 'pending' && incoming().isFeatured == false && incoming().isActive == true && isUserNotBlocked()))
        && (isDefaultCategoryId(incoming().categoryId) || exists(/databases/$(database)/documents/categories/$(incoming().categoryId)));
      allow update: if isSignedIn()
        && isValidId(listingId)
        && isValidListing(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'serviceType', 'listingKind', 'contactPhone', 'hideContactInfo',
            'centerId', 'centerName', 'villageId', 'villageName', 'area', 'notes',
            'price', 'images', 'categoryId', 'subcategoryId', 'submittedByName',
            'status', 'isFeatured', 'isActive', 'updatedAt'
          ])) ||
          (existing().authorUid == request.auth.uid
            && existing().status == 'pending'
            && incoming().status == 'pending'
            && incoming().isFeatured == false
            && incoming().isActive == existing().isActive
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'serviceType', 'contactPhone', 'hideContactInfo',
              'centerId', 'centerName', 'villageId', 'villageName', 'area', 'notes',
              'price', 'images', 'updatedAt'
            ]))
        );
      allow delete: if isValidId(listingId)
        && (isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid && existing().status == 'pending'));
    }

    // Private contact info for Aid requests (PII isolated to owner & admin)
    match /aid_contacts/{listingId} {
      allow get: if isValidId(listingId) && (isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid));
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(listingId)
        && isValidAidContact(incoming())
        && incoming().listingId == listingId
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(listingId)
        && isValidAidContact(incoming())
        && incoming().listingId == existing().listingId
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && (isAdmin() || existing().authorUid == request.auth.uid)
        && incoming().diff(existing()).affectedKeys().hasOnly(['contactPhone', 'requesterName']);
      allow delete: if isValidId(listingId) && (isAdmin() || (isSignedIn() && existing().authorUid == request.auth.uid));
    }

    // Governorate news & alerts (Admin-only writes)
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'priority', 'centerName', 'isActive', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(announcementId);
    }

    // User profiles & favorites (PII isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow list: if isBootstrappedAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || (request.auth.uid == userId && incoming().isBlocked == false));
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'phone', 'email', 'centerId', 'villageId', 'favorites', 'isBlocked', 'updatedAt'
          ])) ||
          (request.auth.uid == userId
            && incoming().isBlocked == existing().isBlocked
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'phone', 'email', 'centerId', 'villageId', 'favorites', 'updatedAt'
            ]))
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // APK updates & release notes (Admin-only writes)
    match /app_updates/{updateId} {
      allow get: if isValidId(updateId) && (existing().isActive == true || isAdmin());
      allow list: if resource.data.isActive == true || isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(updateId)
        && isValidAppUpdate(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(updateId)
        && isValidAppUpdate(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['versionName', 'versionCode', 'releaseNotes', 'apkUrl', 'isActive', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(updateId);
    }
  }
}
